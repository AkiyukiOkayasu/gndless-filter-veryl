/// dutyディザによる線形フェードイン(ソフトミュート)モジュール
///
/// `fade_in`がLowの間は出力を0に保持する。Highへ立ち上げると、窓内位置
/// `fade_pos`がduty(`fade_duty`)未満の間だけ入力を通過させ、平均ゲインを
/// duty/窓で線形に0→1へ増加させる。乗算器を使わないためDSP資源を消費しない。
/// 通過/遮断のトグル周波数は clk/WINDOW で、PWMノイズは帯域外になる。
///
/// フェード時間は WINDOW * WINDOW / FADE_STEP クロック。
/// 例: clk=50MHz, WINDOW=1024, FADE_STEP=2 → 約10.5ms。
pub module SoftFade::<FORMAT: gndless_fixedpoint::SignedFixedPointFormat = gndless_fixedpoint::Q4_23> #(
    param CHANNELS : u32 = 2   , /// チャンネル数
    param WINDOW   : u32 = 1024, /// ディザ窓長(クロック)。トグル周波数 = clk/WINDOW
    param FADE_STEP: u32 = 2   , /// 窓あたりのduty増分。duty最大はWINDOW
) (
    clk    : input   clock                                                                , /// システムクロック
    rst    : input   reset                                                                , /// リセット
    fade_in: input   bbool                                                                , /// フェード制御 (Lowで出力0、Highでフェードイン)
    x      : modport gndless_fixedpoint::FixedPointValue::<FORMAT>::input_port  [CHANNELS], /// 入力
    y      : modport gndless_fixedpoint::FixedPointValue::<FORMAT>::output_port [CHANNELS], /// 出力
) {
    const DUTY_MAX  : u32 = WINDOW;
    const POS_WIDTH : u32 = $clog2(WINDOW);
    const DUTY_WIDTH: u32 = $clog2(WINDOW + 1);

    var fade_pos : logic<POS_WIDTH> ;
    var fade_duty: logic<DUTY_WIDTH>;
    var fade_on  : logic            ;

    // Gowin合成はprocedural forでinterface配列要素を定数選択できないため、
    // generate assignでplain配列へコピーして使う。
    var x_raw: FORMAT::Raw [CHANNELS];
    for channel in 0..CHANNELS :g_x {
        assign x_raw[channel] = x[channel].raw;
    }
    var y_raw  : FORMAT::Raw [CHANNELS];
    var y_raw_q: FORMAT::Raw [CHANNELS];
    for channel in 0..CHANNELS :g_y {
        assign y[channel].raw = y_raw_q[channel];
    }

    always_comb {
        for channel in 0..CHANNELS {
            y_raw[channel] = if fade_on ? x_raw[channel] : FORMAT::ZERO;
        }
    }

    always_ff {
        if_reset {
            fade_pos  = 0;
            fade_duty = 0;
            for channel in 0..CHANNELS {
                y_raw_q[channel] = FORMAT::ZERO;
            }
        } else {
            if !fade_in {
                fade_pos  = 0;
                fade_duty = 0;
            } else if fade_duty != DUTY_MAX {
                if fade_pos != WINDOW - 1 {
                    fade_pos = fade_pos + 1;
                } else {
                    fade_pos = 0;
                    if fade_duty + FADE_STEP >= DUTY_MAX {
                        fade_duty = DUTY_MAX;
                    } else {
                        fade_duty = fade_duty + FADE_STEP;
                    }
                }
            }
            for channel in 0..CHANNELS {
                y_raw_q[channel] = y_raw[channel];
            }
        }
    }

    assign fade_on = fade_pos <: fade_duty;
}

/// ミュート中の出力0、フェード中の平均ゲイン増加、完了後のパススルーを検証する。
/// 窓長8でdutyが2ずつ増えるため、各窓での通過(y==x)回数は 2, 4, 6, 8 になる。
#[test(test_soft_fade)]
module test_soft_fade {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var fade_in: bbool;
    inst x: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23> [2];
    inst y: gndless_fixedpoint::FixedPointValue::<gndless_fixedpoint::Q4_23> [2];

    inst dut: SoftFade::<gndless_fixedpoint::Q4_23> #(
        CHANNELS : 2,
        WINDOW   : 8,
        FADE_STEP: 2,
    ) (
        clk    : clk    ,
        rst    : rst    ,
        fade_in: fade_in,
        x      : x      ,
        y      : y      ,
    );

    var pass_count: logic<8>;
    var win_cnt   : logic<4>;

    always_ff (clk, rst) {
        if_reset {
            pass_count = 0;
            win_cnt    = 0;
        } else {
            if y[0].raw == x[0].raw {
                pass_count = pass_count + 1;
            }
            // 窓境界でリセットする(assertはリセット前の累積値を見る)
            if win_cnt != 7 {
                win_cnt = win_cnt + 1;
            } else {
                win_cnt = 0;
            }
        }
    }

    initial {
        fade_in  = false;
        x[0].raw = 27'sd100;
        x[1].raw = 27'sd200;
        rst.assert();
        clk.next(1);

        // ミュート中は出力0
        for _i in 0..8 {
            $assert(y[0].raw == 27'sd0, "soft fade must mute the output");
            $assert(y[1].raw == 27'sd0, "soft fade must mute all channels");
            clk.next(1);
        }

        // フェード: 窓8ごとにdutyが0→2→4→6→8と増え、累積通過数が2,6,12,20,...になる
        fade_in = true;
        clk.next(8);
        $assert(pass_count == 8'd0, "first window (duty 0) must pass nothing");
        clk.next(8);
        $assert(pass_count == 8'd2, "second window cumulative mismatch");
        clk.next(8);
        $assert(pass_count == 8'd6, "third window cumulative mismatch");
        clk.next(8);
        $assert(pass_count == 8'd12, "fourth window cumulative mismatch");
        clk.next(8);
        // 出力レジスタの1clk遅延のため、最終窓の8回中1回は窓境界の次エッジで数えられる
        $assert(pass_count == 8'd19, "fifth window cumulative mismatch");

        // 完了後は毎窓8回のパススルー
        clk.next(8);
        $assert(pass_count == 8'd27, "completed fade must pass through");

        // 再度Lowへ落とすと2クロック以内にミュートへ戻る(出力レジスタのレイテンシ)
        fade_in = false;
        clk.next(2);
        $assert(y[0].raw == 27'sd0, "fade_in Low must mute immediately");
        $finish();
    }
}
